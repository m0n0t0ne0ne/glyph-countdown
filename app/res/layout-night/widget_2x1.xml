<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@id/w_image_light" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_prev_light_2" android:visibility="gone"
        android:contentDescription="Glyph Countdown timer" />
    <ImageView android:id="@id/w_image_dark" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_prev_2" android:visibility="visible"
        android:contentDescription="Glyph Countdown timer" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <FrameLayout android:id="@id/w_toggle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="40" android:contentDescription="Start timer" />
        <FrameLayout android:id="@id/w_open" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="60" android:contentDescription="Open timer" />
    </LinearLayout>
</FrameLayout>
